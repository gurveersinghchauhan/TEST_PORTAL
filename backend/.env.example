PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string — get this from your Atlas cluster's "Connect" dialog.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority&appName=<app-name>

# Optional, off by default. If local dev hits ERR_SSL_TLSV1_ALERT_INTERNAL_ERROR
# connecting to Atlas, set this to true to bypass TLS certificate validation
# (server.js refuses to honor it when NODE_ENV=production). Note: this alert
# is usually caused by an outdated Node.js/OpenSSL build, not an invalid
# certificate — try upgrading Node to the current LTS first; this flag may
# not actually resolve it.
# MONGO_TLS_INSECURE=true

# Gemini API key — from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Secret used to sign/verify login JWTs. MUST be a long random string in
# real .env files — never reuse this placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# How long a login token stays valid. Optional — defaults to 7d if unset.
JWT_EXPIRES_IN=7d

# The BandUltra platform's own domain — institute subdomains live under
# <label>.BASE_DOMAIN (e.g. a2a.bandultra.com). Optional — defaults to
# 'bandultra.com' in code (see utils/resolveTenantFromHost.js) if unset.
# No DNS is actually configured for this yet — this only controls how
# hostnames are PARSED once real DNS/subdomains exist.
BASE_DOMAIN=bandultra.com
